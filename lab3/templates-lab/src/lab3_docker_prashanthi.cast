[4696.200726, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[4696.201098, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[4696.201521, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[4696.202035, "o", "\u001b[2d"]
[4696.202391, "o", "\u001b[39;49m\u001b(B\u001b[m"]
[4696.202785, "o", "\u001b[?12l\u001b[?25h"]
[4709.406106, "o", "\u001b[?25l"]
[4709.407572, "o", "\u001b[49d"]
[4709.40801, "o", "\u001b[K"]
[4709.463303, "o", "\u001b[1;93H"]
[4709.464043, "o", "\u001b(B\u001b[0;7mModified"]
[4709.464445, "o", "\u001b(B\u001b[m"]
[4709.466733, "o", "\r\u001b[2d"]
[4709.46716, "o", "\u001b(B\u001b[0;1m\u001b[31m# import Jinja2 library and PyYAML\r\u001b[3d"]
[4709.467624, "o", "\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[4709.468035, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[5d"]
[4709.468478, "o", "\u001b(B\u001b[0;1m\u001b[31m# Declare template environment\r\u001b[6d"]
[4709.468948, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[7d"]
[4709.469363, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\r\u001b[8d"]
[4709.469849, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[9d"]
[4709.470249, "o", "network interface by looking for certain keywords in the name\r\u001b[10d"]
[4709.470676, "o", "\"\"\"\r\u001b[11d"]
[4709.471082, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[12d"]
[4709.471521, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\r\u001b[13d"]
[4709.471926, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[14d"]
[4709.472385, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\r\u001b[15d"]
[4709.472795, "o", "\u001b(B\u001b[0;1m\u001b[31m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[16d"]
[4709.473224, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[17d"]
[4709.473654, "o", "# it--the template engine will execute this function when we call\r\u001b[18d"]
[4709.474084, "o", "# template.render()\r\u001b[19d"]
[4709.474497, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[20d"]
[4709.474938, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[21d"]
[4709.475343, "o", "\u001b(B\u001b[0;1m\u001b[31m# We load our YAML file and pass it in to the template when rendering it.\r\u001b[22d"]
[4709.475785, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\r\u001b[23d"]
[4709.476199, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[24d"]
[4709.476613, "o", "print(template.render(interface_list=interfaces))"]
