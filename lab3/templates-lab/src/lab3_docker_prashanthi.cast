[5438.667388, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[5438.667751, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[5438.668152, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[5438.668609, "o", "\u001b[2d"]
[5438.668967, "o", "\u001b[39;49m\u001b(B\u001b[m"]
[5438.669367, "o", "\u001b[?12l\u001b[?25h"]
[5442.086978, "o", "\u001b[?25l"]
[5442.088356, "o", "\u001b[49d"]
[5442.089027, "o", "\u001b[K"]
[5442.096588, "o", "\u001b[1;93H"]
[5442.097069, "o", "\u001b(B\u001b[0;7mModified"]
[5442.09745, "o", "\u001b(B\u001b[m"]
[5442.099431, "o", "\r\u001b[2d"]
[5442.099857, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[3d"]
[5442.100331, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[4d"]
[5442.100723, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m os\r\u001b[6d"]
[5442.101157, "o", "\u001b(B\u001b[0;1m\u001b[31m# Define the path to your templates and data files\r\u001b[7d"]
[5442.101555, "o", "\u001b[39m\u001b(B\u001b[mtemplate_dir = \u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[31m # Assuming templates are in the current directory\r\u001b[8d"]
[5442.102033, "o", "\u001b[39m\u001b(B\u001b[mdata_file = \u001b(B\u001b[0;1m\u001b[32m'network_data.yaml'\r\u001b[10d"]
[5442.102412, "o", "\u001b[31m# Set up Jinja2 environment\r\u001b[11d"]
[5442.102832, "o", "\u001b[39m\u001b(B\u001b[menv = Environment(loader=FileSystemLoader(template_dir), trim_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, lstrip_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[12d"]
[5442.10324, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'router_config.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[14d"]
[5442.103627, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load network data from YAML file\r\u001b[15d"]
[5442.104029, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(data_file, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[16;5H"]
[5442.104381, "o", "network_data = yaml.safe_load(f)\r\u001b[18d"]
[5442.104734, "o", "\u001b(B\u001b[0;1m\u001b[31m# Generate configurations for each router\r\u001b[19d"]
[5442.105118, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router_name, router_details \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m network_data[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m].items():\u001b[20;5H"]
[5442.105494, "o", "config = template.render(router=router_details)\u001b[21;5H"]
[5442.106058, "o", "output_filename = f\u001b(B\u001b[0;1m\u001b[32m\"{router_name}_config.txt\"\u001b[22;5H"]
[5442.10645, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(output_filename, \u001b(B\u001b[0;1m\u001b[32m'w'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[23;9H"]
[5442.106876, "o", "f.write(config)\u001b[24;5H"]
[5442.107324, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {router_name} in {output_filename}\"\u001b[39m\u001b(B\u001b[m)"]
[5442.107682, "o", "\u001b[?12l\u001b[?25h"]
