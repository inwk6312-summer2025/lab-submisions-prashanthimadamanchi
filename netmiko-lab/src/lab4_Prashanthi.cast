[4797.461084, "o", "\u001b[2d"]
[4797.46149, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[4797.461909, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[4797.462264, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[5d"]
[4797.46268, "o", "hosts = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'hosts.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[6d"]
[4797.463075, "o", "interfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[7d"]
[4797.463538, "o", "env = Environment(loader = FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m), trim_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\r\u001b[8d"]
[4797.46393, "o", "autoescape=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[9d"]
[4797.469023, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[4797.46945, "o", "loopback_config = template.render(data=interfaces)\r\u001b[11d"]
[4797.469849, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m host \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m hosts[\u001b(B\u001b[0;1m\u001b[32m\"hosts\"\u001b[39m\u001b(B\u001b[m]:\u001b[12;9H"]
