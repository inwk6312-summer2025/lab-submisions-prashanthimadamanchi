[3944.344206, "o", "\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"22\"\u001b[39m\u001b(B\u001b[m,}]\r\u001b[8d"]
